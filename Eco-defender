<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Eco-Defender: Misión Planeta Clean</title>
    <!-- FontAwesome & Google Fonts -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Rajdhani:wght@500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-color: #050b14;
            --primary: #00ffcc;
            --primary-glow: rgba(0, 255, 204, 0.4);
            --secondary: #ff0055;
            --secondary-glow: rgba(255, 0, 85, 0.4);
            --accent: #ffe600;
            --accent-glow: rgba(255, 230, 0, 0.4);
            --panel-bg: rgba(10, 25, 47, 0.75);
            --panel-border: rgba(0, 255, 204, 0.3);
            --text-color: #e6f1ff;
            --font-heading: 'Orbitron', sans-serif;
            --font-body: 'Rajdhani', sans-serif;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            user-select: none;
            -webkit-user-select: none;
        }

        body, html {
            width: 100%;
            height: 100%;
            overflow: hidden;
            background-color: var(--bg-color);
            font-family: var(--font-body);
            color: var(--text-color);
        }

        #game-container {
            position: relative;
            width: 100vw;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        canvas {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 1;
        }

        /* --- UI OVERLAY LAYER --- */
        .ui-layer {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 10;
            pointer-events: none;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 20px;
        }

        .interactive {
            pointer-events: auto;
        }

        /* Custom Buttons */
        .btn {
            background: linear-gradient(135deg, rgba(0,255,204,0.1), rgba(0,255,204,0.3));
            border: 1px solid var(--primary);
            color: var(--primary);
            padding: 12px 28px;
            font-family: var(--font-heading);
            font-size: 1rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 2px;
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.25s ease;
            box-shadow: 0 0 15px rgba(0,255,204,0.2);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

        .btn:hover {
            background: var(--primary);
            color: #000;
            box-shadow: 0 0 25px var(--primary);
            transform: translateY(-2px);
        }

        .btn:active {
            transform: translateY(1px);
        }

        .btn-secondary {
            border-color: var(--secondary);
            color: var(--secondary);
            background: linear-gradient(135deg, rgba(255,0,85,0.1), rgba(255,0,85,0.3));
            box-shadow: 0 0 15px rgba(255,0,85,0.2);
        }

        .btn-secondary:hover {
            background: var(--secondary);
            color: #fff;
            box-shadow: 0 0 25px var(--secondary);
        }

        .btn-accent {
            border-color: var(--accent);
            color: var(--accent);
            background: linear-gradient(135deg, rgba(255,230,0,0.1), rgba(255,230,0,0.3));
            box-shadow: 0 0 15px rgba(255,230,0,0.2);
        }

        .btn-accent:hover {
            background: var(--accent);
            color: #000;
            box-shadow: 0 0 25px var(--accent);
        }

        .btn:disabled {
            opacity: 0.4;
            cursor: not-allowed;
            box-shadow: none !important;
            transform: none !important;
            border-color: #555 !important;
            color: #888 !important;
            background: rgba(255,255,255,0.05) !important;
        }

        /* Glassmorphic Panel */
        .glass-panel {
            background: var(--panel-bg);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid var(--panel-border);
            border-radius: 12px;
            padding: 30px;
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.7);
        }

        /* HUD STYLES */
        #hud {
            display: none;
            width: 100%;
            justify-content: space-between;
            align-items: flex-start;
        }

        .hud-card {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .bar-container {
            width: 220px;
            height: 16px;
            background: rgba(255,255,255,0.1);
            border-radius: 8px;
            overflow: hidden;
            border: 1px solid rgba(255,255,255,0.2);
            position: relative;
        }

        .bar-fill {
            height: 100%;
            width: 100%;
            transition: width 0.2s ease-out;
        }

        #hp-fill { background: linear-gradient(90deg, #ff0055, #ff5500); }
        #shield-fill { background: linear-gradient(90deg, #0088ff, #00ffcc); }

        .score-display {
            font-family: var(--font-heading);
            font-size: 1.8rem;
            color: #fff;
            text-shadow: 0 0 10px var(--primary-glow);
        }

        .combo-badge {
            font-family: var(--font-heading);
            font-size: 1.2rem;
            color: var(--accent);
            opacity: 0;
            transition: opacity 0.3s, transform 0.3s;
            transform: scale(0.8);
        }

        .combo-badge.active {
            opacity: 1;
            transform: scale(1.1);
        }

        /* MENUS & MODALS */
        .modal-screen {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 20;
            background: rgba(5, 11, 20, 0.85);
            backdrop-filter: blur(8px);
            transition: opacity 0.3s ease;
        }

        .hidden {
            display: none !important;
        }

        .menu-box {
            width: 90%;
            max-width: 650px;
            max-height: 90vh;
            overflow-y: auto;
            text-align: center;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .menu-title {
            font-family: var(--font-heading);
            font-size: 2.8rem;
            background: linear-gradient(90deg, var(--primary), #ffffff, var(--primary));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            text-shadow: 0 0 20px var(--primary-glow);
            letter-spacing: 3px;
        }

        .menu-subtitle {
            color: #88a0c0;
            font-size: 1.1rem;
            margin-top: -10px;
        }

        /* SHOP & ACHIEVEMENTS TABS */
        .tab-nav {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin-bottom: 15px;
        }

        .tab-btn {
            padding: 8px 16px;
            font-family: var(--font-heading);
            font-size: 0.9rem;
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.1);
            color: #aaa;
            border-radius: 4px;
            cursor: pointer;
        }

        .tab-btn.active {
            background: var(--primary);
            color: #000;
            border-color: var(--primary);
            box-shadow: 0 0 10px var(--primary-glow);
        }

        .grid-container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 15px;
            max-height: 400px;
            overflow-y: auto;
            padding-right: 5px;
        }

        .shop-card, .achieve-card {
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 8px;
            padding: 15px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
            transition: all 0.2s;
        }

        .shop-card:hover {
            border-color: var(--primary);
            background: rgba(0,255,204,0.05);
        }

        .shop-card.selected {
            border-color: var(--accent);
            box-shadow: 0 0 15px var(--accent-glow);
        }

        .achieve-card.unlocked {
            border-color: var(--primary);
            background: rgba(0, 255, 204, 0.08);
        }

        .achieve-card.unlocked i {
            color: var(--primary);
        }

        .achieve-card i {
            font-size: 2rem;
            color: #555;
        }

        /* TOAST NOTIFICATIONS */
        #toast-container {
            position: absolute;
            bottom: 20px;
            right: 20px;
            display: flex;
            flex-direction: column;
            gap: 10px;
            z-index: 100;
            pointer-events: none;
        }

        .toast {
            background: rgba(10, 25, 47, 0.9);
            border: 1px solid var(--accent);
            box-shadow: 0 0 15px var(--accent-glow);
            padding: 12px 20px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            gap: 12px;
            animation: slideIn 0.3s ease-out forwards;
        }

        .toast i {
            font-size: 1.5rem;
            color: var(--accent);
        }

        @keyframes slideIn {
            from { transform: translateX(100%); opacity: 0; }
            to { transform: translateX(0); opacity: 1; }
        }

        /* TOUCH CONTROLS FOR MOBILE */
        .touch-controls {
            display: none;
            position: absolute;
            bottom: 20px;
            left: 0;
            width: 100%;
            padding: 0 20px;
            justify-content: space-between;
            align-items: flex-end;
            z-index: 15;
            pointer-events: none;
        }

        .d-pad, .action-pad {
            display: grid;
            grid-template-columns: repeat(3, 50px);
            grid-template-rows: repeat(3, 50px);
            gap: 5px;
            pointer-events: auto;
        }

        .touch-btn {
            background: rgba(255,255,255,0.15);
            border: 1px solid rgba(255,255,255,0.3);
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 1.2rem;
            color: #fff;
            user-select: none;
        }

        .touch-btn:active {
            background: var(--primary);
            color: #000;
        }

        @media (max-width: 768px) {
            .touch-controls { display: flex; }
            .bar-container { width: 140px; }
            .menu-title { font-size: 2rem; }
        }
    </style>
</head>
<body>

    <div id="game-container">
        <canvas id="gameCanvas"></canvas>

        <!-- UI LAYER -->
        <div class="ui-layer">
            <!-- HUD -->
            <div id="hud">
                <div class="hud-card">
                    <div style="font-size: 0.8rem; letter-spacing: 1px; color: #88a0c0;">SALUD DEL CASCO</div>
                    <div class="bar-container">
                        <div id="hp-fill" class="bar-fill"></div>
                    </div>
                    <div style="font-size: 0.8rem; letter-spacing: 1px; color: #88a0c0; margin-top: 4px;">ESCUDO ENERGÍA</div>
                    <div class="bar-container">
                        <div id="shield-fill" class="bar-fill"></div>
                    </div>
                </div>

                <div class="hud-card" style="align-items: flex-end;">
                    <div class="score-display"><span id="score-text">0</span> PTS</div>
                    <div id="combo-badge" class="combo-badge">COMBO x<span id="combo-text">1</span>!</div>
                    <div style="color: var(--accent); font-weight: 700; font-size: 1.1rem; margin-top: 5px;">
                        <i class="fa-solid fa-gem"></i> <span id="crystals-text">0</span>
                    </div>
                </div>
            </div>

            <!-- TOUCH CONTROLS (Mobile) -->
            <div class="touch-controls">
                <div class="d-pad">
                    <div></div>
                    <div class="touch-btn" id="btn-up"><i class="fa-solid fa-arrow-up"></i></div>
                    <div></div>
                    <div class="touch-btn" id="btn-left"><i class="fa-solid fa-arrow-left"></i></div>
                    <div></div>
                    <div class="touch-btn" id="btn-right"><i class="fa-solid fa-arrow-right"></i></div>
                    <div></div>
                    <div class="touch-btn" id="btn-down"><i class="fa-solid fa-arrow-down"></i></div>
                    <div></div>
                </div>
                <div class="action-pad" style="grid-template-columns: 70px; grid-template-rows: 70px;">
                    <div class="touch-btn" id="btn-fire" style="width: 70px; height: 70px; background: rgba(255,0,85,0.3); border-color: var(--secondary);">
                        <i class="fa-solid fa-crosshairs"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- MAIN MENU -->
        <div id="main-menu" class="modal-screen interactive">
            <div class="menu-box glass-panel">
                <h1 class="menu-title">ECO-DEFENDER</h1>
                <p class="menu-subtitle">Misión Planeta Clean 2D</p>
                
                <div style="margin: 15px 0;">
                    <button id="start-btn" class="btn" style="width: 100%; font-size: 1.2rem; padding: 15px;"><i class="fa-solid fa-play"></i> INICIAR MISIÓN</button>
                </div>

                <div class="tab-nav">
                    <button class="tab-btn active" onclick="switchTab('shop')"><i class="fa-solid fa-rocket"></i> Hangar & Tienda</button>
                    <button class="tab-btn" onclick="switchTab('achievements')"><i class="fa-solid fa-trophy"></i> Logros</button>
                    <button class="tab-btn" onclick="switchTab('stats')"><i class="fa-solid fa-chart-line"></i> Estadísticas</button>
                </div>

                <!-- TAB CONTENT: SHOP -->
                <div id="tab-shop" class="tab-content">
                    <div style="margin-bottom: 10px; font-weight: bold; color: var(--accent);">
                        Cristales Disponibles: <i class="fa-solid fa-gem"></i> <span id="shop-crystals">0</span>
                    </div>
                    <div class="grid-container" id="ships-grid"></div>
                </div>

                <!-- TAB CONTENT: ACHIEVEMENTS -->
                <div id="tab-achievements" class="tab-content hidden">
                    <div class="grid-container" id="achievements-grid"></div>
                </div>

                <!-- TAB CONTENT: STATS -->
                <div id="tab-stats" class="tab-content hidden">
                    <div style="display: flex; flex-direction: column; gap: 10px; text-align: left; background: rgba(0,0,0,0.3); padding: 15px; border-radius: 8px;">
                        <div>Puntuación Máxima: <strong id="stat-highscore" style="color:var(--primary)">0</strong></div>
                        <div>Total Partidas Jugadas: <strong id="stat-games">0</strong></div>
                        <div>Basura Espacial Eliminada: <strong id="stat-trash">0</strong></div>
                        <div>Cristales Recolectados: <strong id="stat-crystals">0</strong></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- GAME OVER MODAL -->
        <div id="game-over-menu" class="modal-screen interactive hidden">
            <div class="menu-box glass-panel">
                <h2 class="menu-title" style="color: var(--secondary);">MISIÓN FALLIDA</h2>
                <p id="game-over-reason" style="color: #aaa;">Tu nave fue destruida por desechos.</p>
                
                <div style="background: rgba(0,0,0,0.4); padding: 20px; border-radius: 8px; margin: 15px 0;">
                    <div style="font-size: 1.2rem; margin-bottom: 8px;">Puntuación Final: <strong id="go-score" style="color:var(--primary);">0</strong></div>
                    <div style="font-size: 1rem; color: var(--accent);">Cristales Ganados: +<span id="go-crystals">0</span></div>
                    <div style="font-size: 0.9rem; color: #88a0c0; margin-top: 5px;">Max Combo: <span id="go-combo">x1</span></div>
                </div>

                <div style="display: flex; gap: 10px; justify-content: center;">
                    <button id="restart-btn" class="btn"><i class="fa-solid fa-rotate-right"></i> REINTENTAR</button>
                    <button id="menu-btn" class="btn btn-secondary"><i class="fa-solid fa-house"></i> MENÚ</button>
                </div>
            </div>
        </div>

        <!-- TOAST CONTAINER -->
        <div id="toast-container"></div>
    </div>

    <script>
        /* ==========================================================================
           1. AUDIO SYNTHESIZER (Web Audio API)
           ========================================================================== */
        class SoundFX {
            constructor() {
                this.ctx = null;
            }

            init() {
                if (!this.ctx) {
                    this.ctx = new (window.AudioContext || window.webkitAudioContext)();
                }
            }

            playShoot() {
                if (!this.ctx) return;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = 'sawtooth';
                osc.frequency.setValueAtTime(800, this.ctx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(100, this.ctx.currentTime + 0.15);
                gain.gain.setValueAtTime(0.2, this.ctx.currentTime);
                gain.gain.linearRampToValueAtTime(0.01, this.ctx.currentTime + 0.15);
                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.start();
                osc.stop(this.ctx.currentTime + 0.15);
            }

            playExplosion() {
                if (!this.ctx) return;
                const bufferSize = this.ctx.sampleRate * 0.3;
                const buffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);
                const data = buffer.getChannelData(0);
                for (let i = 0; i < bufferSize; i++) {
                    data[i] = Math.random() * 2 - 1;
                }
                const noise = this.ctx.createBufferSource();
                noise.buffer = buffer;

                const filter = this.ctx.createBiquadFilter();
                filter.type = 'lowpass';
                filter.frequency.setValueAtTime(800, this.ctx.currentTime);
                filter.frequency.linearRampToValueAtTime(50, this.ctx.currentTime + 0.3);

                const gain = this.ctx.createGain();
                gain.gain.setValueAtTime(0.4, this.ctx.currentTime);
                gain.gain.linearRampToValueAtTime(0.01, this.ctx.currentTime + 0.3);

                noise.connect(filter);
                filter.connect(gain);
                gain.connect(this.ctx.destination);
                noise.start();
            }

            playPickup() {
                if (!this.ctx) return;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(440, this.ctx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(880, this.ctx.currentTime + 0.12);
                gain.gain.setValueAtTime(0.2, this.ctx.currentTime);
                gain.gain.linearRampToValueAtTime(0.01, this.ctx.currentTime + 0.12);
                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.start();
                osc.stop(this.ctx.currentTime + 0.12);
            }

            playAchievement() {
                if (!this.ctx) return;
                const now = this.ctx.currentTime;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = 'triangle';
                
                osc.frequency.setValueAtTime(523.25, now); // C5
                osc.frequency.setValueAtTime(659.25, now + 0.1); // E5
                osc.frequency.setValueAtTime(783.99, now + 0.2); // G5
                osc.frequency.setValueAtTime(1046.50, now + 0.3); // C6

                gain.gain.setValueAtTime(0.3, now);
                gain.gain.linearRampToValueAtTime(0.01, now + 0.5);

                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.start();
                osc.stop(now + 0.5);
            }
        }

        const audio = new SoundFX();

        /* ==========================================================================
           2. GAME DATA & PROGRESSION (LocalStorage)
           ========================================================================== */
        const SHIPS = [
            { id: 'basic', name: 'Eco-Scout', price: 0, speed: 6, hp: 100, fireRate: 200, color: '#00ffcc', unlocked: true },
            { id: 'defender', name: 'Aegis Shield', price: 100, speed: 4.5, hp: 180, fireRate: 250, color: '#0088ff', unlocked: false },
            { id: 'speeder', name: 'Plasma Dart', price: 250, speed: 8.5, hp: 80, fireRate: 130, color: '#ffe600', unlocked: false },
            { id: 'destroyer', name: 'Clean Blaster', price: 500, speed: 6, hp: 120, fireRate: 90, color: '#ff0055', unlocked: false }
        ];

        const ACHIEVEMENTS = [
            { id: 'first_clean', title: 'Primera Limpieza', desc: 'Destruye 10 objetos de basura', icon: 'fa-broom', unlocked: false, req: (s) => s.trash >= 10 },
            { id: 'combo_master', title: 'Francotirador', desc: 'Consigue un combo x5', icon: 'fa-bolt', unlocked: false, req: (s) => s.maxCombo >= 5 },
            { id: 'score_1k', title: 'Planeta Salvo', desc: 'Alcanza 1,000 puntos', icon: 'fa-star', unlocked: false, req: (s) => s.highScore >= 1000 },
            { id: 'collector', title: 'Minero Espacial', desc: 'Recolecta 50 cristales', icon: 'fa-gem', unlocked: false, req: (s) => s.crystals >= 50 }
        ];

        let playerData = {
            crystals: 0,
            highScore: 0,
            gamesPlayed: 0,
            trashDestroyed: 0,
            maxCombo: 1,
            selectedShip: 'basic',
            unlockedShips: ['basic'],
            unlockedAchievements: []
        };

        function loadData() {
            const saved = localStorage.getItem('eco_defender_data');
            if (saved) {
                try {
                    playerData = { ...playerData, ...JSON.parse(saved) };
                } catch(e) { console.error("Error loading save", e); }
            }
            // Update structures
            SHIPS.forEach(s => s.unlocked = playerData.unlockedShips.includes(s.id));
            ACHIEVEMENTS.forEach(a => a.unlocked = playerData.unlockedAchievements.includes(a.id));
        }

        function saveData() {
            localStorage.setItem('eco_defender_data', JSON.stringify(playerData));
        }

        function checkAchievements(currentSessionStats) {
            let tempStats = {
                trash: playerData.trashDestroyed,
                maxCombo: Math.max(playerData.maxCombo, currentSessionStats.combo || 0),
                highScore: Math.max(playerData.highScore, currentSessionStats.score || 0),
                crystals: playerData.crystals
            };

            ACHIEVEMENTS.forEach(ach => {
                if (!ach.unlocked && ach.req(tempStats)) {
                    ach.unlocked = true;
                    playerData.unlockedAchievements.push(ach.id);
                    showToast(ach.title, ach.desc);
                    audio.playAchievement();
                    saveData();
                }
            });
        }

        function showToast(title, desc) {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            toast.className = 'toast';
            toast.innerHTML = `<i class="fa-solid fa-trophy"></i><div><strong style="color:#fff;display:block;">${title}</strong><span style="font-size:0.85rem;color:#aaa;">${desc}</span></div>`;
            container.appendChild(toast);
            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transition = 'opacity 0.5s';
                setTimeout(() => toast.remove(), 500);
            }, 4000);
        }

        /* ==========================================================================
           3. GAME ENGINE & CANVAS LOGIC
           ========================================================================== */
        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');

        function resizeCanvas() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        // Input state
        const keys = {};
        window.addEventListener('keydown', e => keys[e.code] = true);
        window.addEventListener('keyup', e => keys[e.code] = false);

        // Mobile Controls setup
        const bindTouch = (id, keyName) => {
            const el = document.getElementById(id);
            if (!el) return;
            el.addEventListener('touchstart', (e) => { e.preventDefault(); keys[keyName] = true; });
            el.addEventListener('touchend', (e) => { e.preventDefault(); keys[keyName] = false; });
        };
        bindTouch('btn-up', 'KeyW');
        bindTouch('btn-down', 'KeyS');
        bindTouch('btn-left', 'KeyA');
        bindTouch('btn-right', 'KeyD');
        bindTouch('btn-fire', 'Space');

        // Starfield Parallax Background
        class Starfield {
            constructor() {
                this.stars = Array.from({ length: 150 }, () => ({
                    x: Math.random() * canvas.width,
                    y: Math.random() * canvas.height,
                    size: Math.random() * 2,
                    speed: Math.random() * 1.5 + 0.2,
                    opacity: Math.random()
                }));
            }
            update() {
                this.stars.forEach(s => {
                    s.y += s.speed;
                    if (s.y > canvas.height) {
                        s.y = 0;
                        s.x = Math.random() * canvas.width;
                    }
                });
            }
            draw() {
                ctx.fillStyle = '#ffffff';
                this.stars.forEach(s => {
                    ctx.globalAlpha = s.opacity;
                    ctx.fillRect(s.x, s.y, s.size, s.size);
                });
                ctx.globalAlpha = 1.0;
            }
        }

        // Particle System
        class Particle {
            constructor(x, y, color, speed, size, life) {
                this.x = x;
                this.y = y;
                this.color = color;
                const angle = Math.random() * Math.PI * 2;
                this.vx = Math.cos(angle) * (Math.random() * speed);
                this.vy = Math.sin(angle) * (Math.random() * speed);
                this.size = size;
                this.maxLife = life;
                this.life = life;
            }
            update() {
                this.x += this.vx;
                this.y += this.vy;
                this.life--;
            }
            draw() {
                ctx.save();
                ctx.globalAlpha = this.life / this.maxLife;
                ctx.fillStyle = this.color;
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                ctx.fill();
                ctx.restore();
            }
        }

        // Player Ship Entity
        class Player {
            constructor(shipConfig) {
                this.x = canvas.width / 2;
                this.y = canvas.height - 100;
                this.radius = 20;
                this.config = shipConfig;
                this.vx = 0;
                this.vy = 0;
                this.friction = 0.92;
                this.hp = shipConfig.hp;
                this.maxHp = shipConfig.hp;
                this.shield = 50;
                this.maxShield = 50;
                this.lastShot = 0;
            }

            update() {
                const accel = 0.8;
                if (keys['KeyW'] || keys['ArrowUp']) this.vy -= accel;
                if (keys['KeyS'] || keys['ArrowDown']) this.vy += accel;
                if (keys['KeyA'] || keys['ArrowLeft']) this.vx -= accel;
                if (keys['KeyD'] || keys['ArrowRight']) this.vx += accel;

                // Apply velocity and friction
                this.vx *= this.friction;
                this.vy *= this.friction;
                this.x += this.vx;
                this.y += this.vy;

                // Screen boundaries
                this.x = Math.max(this.radius, Math.min(canvas.width - this.radius, this.x));
                this.y = Math.max(this.radius, Math.min(canvas.height - this.radius, this.y));

                // Shield Regeneration
                if (this.shield < this.maxShield) {
                    this.shield += 0.05;
                }

                // Thruster Particles
                if (Math.abs(this.vx) > 0.5 || Math.abs(this.vy) > 0.5) {
                    particles.push(new Particle(
                        this.x + (Math.random() - 0.5) * 10,
                        this.y + 18,
                        this.config.color,
                        2, Math.random() * 4 + 1, 15
                    ));
                }

                // Shooting
                if ((keys['Space'] || keys['KeyZ']) && Date.now() - this.lastShot > this.config.fireRate) {
                    this.shoot();
                    this.lastShot = Date.now();
                }
            }

            shoot() {
                audio.playShoot();
                bullets.push(new Bullet(this.x, this.y - 15, this.config.color));
            }

            draw() {
                ctx.save();
                ctx.translate(this.x, this.y);

                // Shield effect
                if (this.shield > 5) {
                    ctx.strokeStyle = `rgba(0, 136, 255, ${this.shield / this.maxShield * 0.6})`;
                    ctx.lineWidth = 3;
                    ctx.beginPath();
                    ctx.arc(0, 0, this.radius + 6, 0, Math.PI * 2);
                    ctx.stroke();
                }

                // Ship Body
                ctx.fillStyle = this.config.color;
                ctx.shadowColor = this.config.color;
                ctx.shadowBlur = 12;

                ctx.beginPath();
                ctx.moveTo(0, -this.radius);
                ctx.lineTo(-this.radius, this.radius);
                ctx.lineTo(0, this.radius * 0.6);
                ctx.lineTo(this.radius, this.radius);
                ctx.closePath();
                ctx.fill();

                ctx.restore();
            }
        }

        // Bullet Entity
        class Bullet {
            constructor(x, y, color) {
                this.x = x;
                this.y = y;
                this.speed = 14;
                this.radius = 4;
                this.color = color;
                this.markedForDeletion = false;
            }
            update() {
                this.y -= this.speed;
                if (this.y < -10) this.markedForDeletion = true;
            }
            draw() {
                ctx.save();
                ctx.fillStyle = this.color;
                ctx.shadowColor = this.color;
                ctx.shadowBlur = 8;
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
                ctx.fill();
                ctx.restore();
            }
        }

        // Debris / Hazard Entity
        class Obstacle {
            constructor() {
                this.x = Math.random() * (canvas.width - 40) + 20;
                this.y = -30;
                this.type = Math.random() > 0.3 ? 'trash' : 'asteroid'; // 70% Trash, 30% Asteroid
                this.radius = this.type === 'trash' ? 16 : 26;
                this.speed = Math.random() * 2 + 1.5;
                this.rotation = 0;
                this.rotSpeed = (Math.random() - 0.5) * 0.05;
                this.hp = this.type === 'trash' ? 1 : 3;
                this.markedForDeletion = false;
            }
            update() {
                this.y += this.speed;
                this.rotation += this.rotSpeed;
                if (this.y > canvas.height + 40) this.markedForDeletion = true;
            }
            draw() {
                ctx.save();
                ctx.translate(this.x, this.y);
                ctx.rotate(this.rotation);

                if (this.type === 'trash') {
                    // Space Trash (Satellite/Barrel style)
                    ctx.fillStyle = '#99aa88';
                    ctx.strokeStyle = '#556644';
                    ctx.lineWidth = 2;
                    ctx.fillRect(-12, -12, 24, 24);
                    ctx.strokeRect(-12, -12, 24, 24);
                } else {
                    // Asteroid
                    ctx.fillStyle = '#555566';
                    ctx.strokeStyle = '#777788';
                    ctx.lineWidth = 2;
                    ctx.beginPath();
                    ctx.arc(0, 0, this.radius, 0, Math.PI * 2);
                    ctx.fill();
                    ctx.stroke();
                }

                ctx.restore();
            }
        }

        // Energy Crystal Entity
        class Crystal {
            constructor(x, y) {
                this.x = x;
                this.y = y;
                this.radius = 10;
                this.speed = 1.5;
                this.markedForDeletion = false;
                this.pulse = 0;
            }
            update() {
                this.y += this.speed;
                this.pulse += 0.08;
                if (this.y > canvas.height + 20) this.markedForDeletion = true;
            }
            draw() {
                ctx.save();
                ctx.translate(this.x, this.y);
                const scale = 1 + Math.sin(this.pulse) * 0.15;
                ctx.scale(scale, scale);
                ctx.fillStyle = '#ffe600';
                ctx.shadowColor = '#ffe600';
                ctx.shadowBlur = 10;
                
                // Diamond Shape
                ctx.beginPath();
                ctx.moveTo(0, -10);
                ctx.lineTo(8, 0);
                ctx.lineTo(0, 10);
                ctx.lineTo(-8, 0);
                ctx.closePath();
                ctx.fill();
                ctx.restore();
            }
        }

        /* ==========================================================================
           4. GAME STATE MANAGEMENT & LOOP
           ========================================================================== */
        let starfield = new Starfield();
        let player = null;
        let bullets = [];
        let obstacles = [];
        let crystals = [];
        let particles = [];
        
        let gameState = 'MENU'; // MENU, PLAYING, GAMEOVER
        let score = 0;
        let sessionCrystals = 0;
        let combo = 1;
        let comboTimer = null;
        let spawnTimer = 0;
        let sessionTrashDestroyed = 0;

        function startGame() {
            audio.init();
            const shipConfig = SHIPS.find(s => s.id === playerData.selectedShip);
            player = new Player(shipConfig);
            bullets = [];
            obstacles = [];
            crystals = [];
            particles = [];
            score = 0;
            sessionCrystals = 0;
            combo = 1;
            sessionTrashDestroyed = 0;

            gameState = 'PLAYING';
            updateHUD();

            document.getElementById('main-menu').classList.add('hidden');
            document.getElementById('game-over-menu').classList.add('hidden');
            document.getElementById('hud').style.display = 'flex';
        }

        function triggerExplosion(x, y, color, count = 15) {
            for (let i = 0; i < count; i++) {
                particles.push(new Particle(x, y, color, 4, Math.random() * 4 + 1, 25));
            }
        }

        function checkCollisions() {
            // Bullets vs Obstacles
            bullets.forEach(b => {
                obstacles.forEach(o => {
                    if (!b.markedForDeletion && !o.markedForDeletion) {
                        const dist = Math.hypot(b.x - o.x, b.y - o.y);
                        if (dist < b.radius + o.radius) {
                            b.markedForDeletion = true;
                            o.hp--;
                            triggerExplosion(b.x, b.y, '#ffffff', 5);

                            if (o.hp <= 0) {
                                o.markedForDeletion = true;
                                triggerExplosion(o.x, o.y, o.type === 'trash' ? '#99aa88' : '#777788', 18);
                                audio.playExplosion();

                                // Update Stats & Combo
                                score += 50 * combo;
                                sessionTrashDestroyed++;
                                combo++;
                                resetComboTimer();

                                // Drop Crystal chance
                                if (Math.random() < 0.4) {
                                    crystals.push(new Crystal(o.x, o.y));
                                }

                                checkAchievements({ score, combo });
                            }
                        }
                    }
                });
            });

            // Player vs Obstacles
            obstacles.forEach(o => {
                if (!o.markedForDeletion) {
                    const dist = Math.hypot(player.x - o.x, player.y - o.y);
                    if (dist < player.radius + o.radius) {
                        o.markedForDeletion = true;
                        triggerExplosion(o.x, o.y, '#ff0055', 20);
                        audio.playExplosion();

                        // Combo Reset
                        combo = 1;
                        updateHUD();

                        // Damage Logic
                        const damage = o.type === 'trash' ? 20 : 35;
                        if (player.shield > 0) {
                            player.shield -= damage;
                            if (player.shield < 0) {
                                player.hp += player.shield; // Overflow to HP
                                player.shield = 0;
                            }
                        } else {
                            player.hp -= damage;
                        }

                        if (player.hp <= 0) {
                            gameOver("Destruido por colisión espacial.");
                        }
                    }
                }
            });

            // Player vs Crystals
            crystals.forEach(c => {
                if (!c.markedForDeletion) {
                    const dist = Math.hypot(player.x - c.x, player.y - c.y);
                    if (dist < player.radius + c.radius) {
                        c.markedForDeletion = true;
                        sessionCrystals++;
                        playerData.crystals++;
                        audio.playPickup();
                        triggerExplosion(c.x, c.y, '#ffe600', 8);
                        updateHUD();
                        saveData();
                        checkAchievements({ score, combo });
                    }
                }
            });
        }

        function resetComboTimer() {
            const badge = document.getElementById('combo-badge');
            badge.classList.add('active');
            clearTimeout(comboTimer);
            comboTimer = setTimeout(() => {
                combo = 1;
                badge.classList.remove('active');
                updateHUD();
            }, 3000);
            updateHUD();
        }

        function updateHUD() {
            if (!player) return;
            document.getElementById('hp-fill').style.width = `${Math.max(0, (player.hp / player.maxHp) * 100)}%`;
            document.getElementById('shield-fill').style.width = `${Math.max(0, (player.shield / player.maxShield) * 100)}%`;
            document.getElementById('score-text').innerText = score;
            document.getElementById('combo-text').innerText = combo;
            document.getElementById('crystals-text').innerText = playerData.crystals;
        }

        function gameOver(reason) {
            gameState = 'GAMEOVER';
            audio.playExplosion();

            // Save persistent stats
            playerData.gamesPlayed++;
            playerData.trashDestroyed += sessionTrashDestroyed;
            if (score > playerData.highScore) playerData.highScore = score;
            if (combo > playerData.maxCombo) playerData.maxCombo = combo;
            saveData();

            // Update Game Over Modal
            document.getElementById('game-over-reason').innerText = reason;
            document.getElementById('go-score').innerText = score;
            document.getElementById('go-crystals').innerText = sessionCrystals;
            document.getElementById('go-combo').innerText = `x${combo}`;
            
            document.getElementById('hud').style.display = 'none';
            document.getElementById('game-over-menu').classList.remove('hidden');
        }

        function gameLoop() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            // Always update Parallax background
            starfield.update();
            starfield.draw();

            if (gameState === 'PLAYING') {
                // Spawn Logic
                spawnTimer++;
                if (spawnTimer % 45 === 0) {
                    obstacles.push(new Obstacle());
                }

                // Update & Draw Entities
                player.update();
                player.draw();

                bullets.forEach(b => b.update());
                obstacles.forEach(o => o.update());
                crystals.forEach(c => c.update());
                particles.forEach(p => p.update());

                // Filter deleted entities
                bullets = bullets.filter(b => !b.markedForDeletion);
                obstacles = obstacles.filter(o => !o.markedForDeletion);
                crystals = crystals.filter(c => !c.markedForDeletion);
                particles = particles.filter(p => p.life > 0);

                // Draw Entities
                bullets.forEach(b => b.draw());
                obstacles.forEach(o => o.draw());
                crystals.forEach(c => c.draw());
                particles.forEach(p => p.draw());

                checkCollisions();
                updateHUD();
            }

            requestAnimationFrame(gameLoop);
        }

        /* ==========================================================================
           5. UI RENDERERS & EVENT LISTENERS
           ========================================================================== */
        function switchTab(tabName) {
            document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
            document.querySelectorAll('.tab-content').forEach(content => content.classList.add('hidden'));

            event.currentTarget.classList.add('active');
            document.getElementById(`tab-${tabName}`).classList.remove('hidden');

            if (tabName === 'shop') renderShop();
            if (tabName === 'achievements') renderAchievements();
            if (tabName === 'stats') renderStats();
        }

        function renderShop() {
            document.getElementById('shop-crystals').innerText = playerData.crystals;
            const grid = document.getElementById('ships-grid');
            grid.innerHTML = '';

            SHIPS.forEach(ship => {
                const isSelected = playerData.selectedShip === ship.id;
                const card = document.createElement('div');
                card.className = `shop-card ${isSelected ? 'selected' : ''}`;
                card.innerHTML = `
                    <div style="font-family:var(--font-heading); color:${ship.color}; font-weight:bold;">${ship.name}</div>
                    <div style="font-size:0.85rem; color:#aaa;">Velocidad: ${ship.speed} | HP: ${ship.hp}</div>
                    <div style="margin-top:5px;">
                        ${ship.unlocked 
                            ? `<button class="btn" style="padding:5px 15px; font-size:0.8rem;" ${isSelected ? 'disabled' : ''} onclick="selectShip('${ship.id}')">
                                ${isSelected ? 'SELECCIONADO' : 'EQUIPAR'}
                              </button>`
                            : `<button class="btn btn-accent" style="padding:5px 15px; font-size:0.8rem;" ${playerData.crystals < ship.price ? 'disabled' : ''} onclick="buyShip('${ship.id}')">
                                <i class="fa-solid fa-gem"></i> ${ship.price}
                              </button>`
                        }
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        function selectShip(id) {
            playerData.selectedShip = id;
            saveData();
            renderShop();
        }

        function buyShip(id) {
            const ship = SHIPS.find(s => s.id === id);
            if (ship && playerData.crystals >= ship.price) {
                playerData.crystals -= ship.price;
                playerData.unlockedShips.push(id);
                ship.unlocked = true;
                playerData.selectedShip = id;
                saveData();
                renderShop();
                audio.playPickup();
            }
        }

        function renderAchievements() {
            const grid = document.getElementById('achievements-grid');
            grid.innerHTML = '';

            ACHIEVEMENTS.forEach(ach => {
                const card = document.createElement('div');
                card.className = `achieve-card ${ach.unlocked ? 'unlocked' : ''}`;
                card.innerHTML = `
                    <i class="fa-solid ${ach.icon}"></i>
                    <div style="font-weight:bold; font-size:0.95rem;">${ach.title}</div>
                    <div style="font-size:0.8rem; color:#aaa; text-align:center;">${ach.desc}</div>
                `;
                grid.appendChild(card);
            });
        }

        function renderStats() {
            document.getElementById('stat-highscore').innerText = playerData.highScore;
            document.getElementById('stat-games').innerText = playerData.gamesPlayed;
            document.getElementById('stat-trash').innerText = playerData.trashDestroyed;
            document.getElementById('stat-crystals').innerText = playerData.crystals;
        }

        // Event Listeners for Buttons
        document.getElementById('start-btn').addEventListener('click', startGame);
        document.getElementById('restart-btn').addEventListener('click', startGame);
        document.getElementById('menu-btn').addEventListener('click', () => {
            document.getElementById('game-over-menu').classList.add('hidden');
            document.getElementById('main-menu').classList.remove('hidden');
            gameState = 'MENU';
            renderShop();
        });

        // Initialize App
        loadData();
        renderShop();
        requestAnimationFrame(gameLoop);
    </script>
</body>
</html>
